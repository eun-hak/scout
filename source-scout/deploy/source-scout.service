[Unit]
Description=Source Scout
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/git/scout/source-scout
EnvironmentFile=/home/ubuntu/.config/source-scout/source-scout.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m source_scout
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/source-scout

[Install]
WantedBy=multi-user.target
